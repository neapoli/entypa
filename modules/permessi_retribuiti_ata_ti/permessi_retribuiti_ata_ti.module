<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_theme_registry_alter().
 *
 * Registers the entity_print template suggestion for the "adesione_a_commissioni"
 * webform so entity_print can find the file in this submodule's templates directory.
 */
function permessi_retribuiti_ata_ti_theme_registry_alter(&$theme_registry) {
  if (!isset($theme_registry['entity_print'])) {
    return;
  }
  $module_path = \Drupal::service('extension.list.module')->getPath('permessi_retribuiti_ata_ti');
  $theme_registry['entity_print__webform_submission__permessi_retribuiti_ata_ti'] = [
    'base hook' => 'entity_print',
    'path' => $module_path . '/templates/entity_print',
    'template' => 'entity-print--webform-submission--permessi-retribuiti-ata-ti',
    'type' => 'module',
    'theme path' => $module_path,
    'variables' => $theme_registry['entity_print']['variables'] ?? [],
    'preprocess functions' => $theme_registry['entity_print']['preprocess functions'] ?? [],
  ];
}

/**
 * Giorni spettanti per ciascuna fattispecie, e articolo che li prevede.
 *
 * Il tetto è quello della singola fattispecie: quante giornate siano già state
 * fruite nell'anno scolastico il formulario non lo sa, e resta un riscontro
 * della segreteria.
 */
function _permessi_retribuiti_ata_ti_tetti() {
  return [
    'Partecipazione a concorso/esame' => [8, 'art. 15, comma 1, del CCNL 29/11/2007'],
    'Lutto familiare' => [3, 'art. 15, comma 1, del CCNL 29/11/2007'],
    'Matrimonio' => [15, 'art. 15, comma 3, del CCNL 29/11/2007'],
  ];
}

/**
 * Implements hook_webform_submission_form_alter().
 */
function permessi_retribuiti_ata_ti_webform_submission_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $webform = $form_state->getFormObject()->getEntity()->getWebform();
  if ($webform && $webform->id() === 'permessi_retribuiti_ata_ti') {
    entypa_aggiungi_validazione($form, 'numero_giorni', 'permessi_retribuiti_ata_ti_valida');
  }
}

/**
 * Verifica che i giorni richiesti rientrino nel tetto della fattispecie.
 */
function permessi_retribuiti_ata_ti_valida(array &$elemento, FormStateInterface $form_state) {
  $tipologia = (string) $form_state->getValue('tipologia_richiesta');
  $giorni = (int) $form_state->getValue('numero_giorni');
  $tetti = _permessi_retribuiti_ata_ti_tetti();

  if (isset($tetti[$tipologia]) && $giorni > $tetti[$tipologia][0]) {
    [$tetto, $norma] = $tetti[$tipologia];
    $form_state->setErrorByName('numero_giorni', t(
      'La domanda chiede @giorni giorni, ma per «@tipologia» ne spettano @tetto (@norma).',
      ['@giorni' => $giorni, '@tipologia' => $tipologia, '@tetto' => $tetto, '@norma' => $norma]
    ));
  }
}
