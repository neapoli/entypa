<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_theme_registry_alter().
 *
 * Registers the entity_print template suggestion for the "ferie_estive_soc"
 * webform so entity_print can find the file in this submodule's templates directory.
 */
function l104_assistenza_ata_theme_registry_alter(&$theme_registry) {
  if (!isset($theme_registry['entity_print'])) {
    return;
  }
  $module_path = \Drupal::service('extension.list.module')->getPath('l104_assistenza_ata');
  $theme_registry['entity_print__webform_submission__assenza_104_assistenza_fam_ata'] = [
    'base hook' => 'entity_print',
    'path' => $module_path . '/templates/entity_print',
    'template' => 'entity-print--webform-submission--assenza-104-assistenza-fam-ata',
    'type' => 'module',
    'theme path' => $module_path,
    'variables' => $theme_registry['entity_print']['variables'] ?? [],
    'preprocess functions' => $theme_registry['entity_print']['preprocess functions'] ?? [],
  ];
}

/**
 * Tetti mensili dei permessi: tre giorni, oppure 18 ore per il personale ATA.
 *
 * @see art. 33, comma 3, della L. 104/1992
 * @see art. 68, comma 1, del CCNL Istruzione e Ricerca 2019-2021
 */
const L104_ASSISTENZA_ATA_GIORNI_AL_MESE = 3;
const L104_ASSISTENZA_ATA_ORE_AL_MESE = 18;

/**
 * Implements hook_ENTITY_TYPE_presave() for webform_submission entities.
 *
 * Ricalcola i giorni di ciascun periodo e il totale. I campi sono readonly e
 * li riempie il JavaScript, quindi il valore che finisce sull'istanza firmata
 * deve nascere qui.
 */
function l104_assistenza_ata_webform_submission_presave(WebformSubmissionInterface $webform_submission) {
  $webform = $webform_submission->getWebform();
  if (!$webform || $webform->id() !== 'assenza_104_assistenza_fam_ata') {
    return;
  }

  $data = $webform_submission->getData();
  $periodi = $data['periodi_richiesti'] ?? [];
  if (!is_array($periodi)) {
    return;
  }

  $totale = 0;
  $conteggiati = FALSE;
  foreach ($periodi as $indice => $periodo) {
    $giorni = entypa_giorni_lavorativi(
      $periodo['data_inizio'] ?? '',
      $periodo['data_fine'] ?? ''
    );
    $periodi[$indice]['numero_giorni'] = ($giorni === NULL) ? '' : (string) $giorni;
    if ($giorni !== NULL) {
      $totale += $giorni;
      $conteggiati = TRUE;
    }
  }

  $data['periodi_richiesti'] = $periodi;
  $data['totale_giorni'] = $conteggiati ? (string) $totale : '';
  $webform_submission->setData($data);
}

/**
 * Implements hook_webform_submission_form_alter().
 */
function l104_assistenza_ata_webform_submission_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $webform = $form_state->getFormObject()->getEntity()->getWebform();
  if (!$webform || $webform->id() !== 'assenza_104_assistenza_fam_ata') {
    return;
  }

  // Una validazione per tetto, agganciata al totale cui si riferisce: così il
  // messaggio esce accanto al numero giusto, e quando la scelta nasconde una
  // delle due tabelle Webform sopprime la validazione del suo totale.
  entypa_aggiungi_validazione($form, 'totale_giorni', 'l104_assistenza_ata_valida_giorni');
  entypa_aggiungi_validazione($form, 'per_un_totale_di_ore', 'l104_assistenza_ata_valida_ore');
}

/**
 * Validazione del tetto mensile dei giorni.
 */
function l104_assistenza_ata_valida_giorni(array &$elemento, FormStateInterface $form_state) {
  $perMese = [];
  foreach ((array) $form_state->getValue('periodi_richiesti') as $periodo) {
    $inizio = $periodo['data_inizio'] ?? '';
    $conteggio = entypa_giorni_lavorativi($inizio, $periodo['data_fine'] ?? '');
    if ($conteggio === NULL) {
      continue;
    }
    $mese = substr((string) $inizio, 0, 7);
    $perMese[$mese] = ($perMese[$mese] ?? 0) + $conteggio;
  }

  _l104_assistenza_ata_segnala(
    $form_state, 'totale_giorni', $perMese, L104_ASSISTENZA_ATA_GIORNI_AL_MESE,
    'giorni', 'I permessi spettano nella misura di tre giorni al mese (art. 33, comma 3, della L. 104/1992).'
  );
}

/**
 * Validazione del tetto mensile delle ore.
 */
function l104_assistenza_ata_valida_ore(array &$elemento, FormStateInterface $form_state) {
  $perMese = [];
  foreach ((array) $form_state->getValue('permesso_orario') as $riga) {
    $durata = _l104_assistenza_ata_ore($riga['ora_inizio'] ?? '', $riga['ora_fine'] ?? '');
    if ($durata === NULL) {
      continue;
    }
    $mese = substr((string) ($riga['giorno'] ?? ''), 0, 7);
    $perMese[$mese] = ($perMese[$mese] ?? 0) + $durata;
  }

  _l104_assistenza_ata_segnala(
    $form_state, 'per_un_totale_di_ore', $perMese, L104_ASSISTENZA_ATA_ORE_AL_MESE,
    'ore', 'Il personale ATA può fruire dei permessi ad ore nel limite di 18 ore mensili (art. 68, comma 1, del CCNL 2019-2021).'
  );
}

/**
 * Durata in ore fra due orari nella forma HH:MM, o NULL se non calcolabile.
 */
function _l104_assistenza_ata_ore($inizio, $fine) {
  if (!preg_match('/^(\d{1,2}):(\d{2})/', (string) $inizio, $a)
    || !preg_match('/^(\d{1,2}):(\d{2})/', (string) $fine, $b)) {
    return NULL;
  }

  $minuti = ((int) $b[1] * 60 + (int) $b[2]) - ((int) $a[1] * 60 + (int) $a[2]);
  return $minuti > 0 ? $minuti / 60 : NULL;
}

/**
 * Segnala i mesi che eccedono il tetto, su un campo semplice.
 *
 * L'errore non va mai sul composite: FormState::getError() risale i #parents,
 * e ogni sottocampo di ogni riga ristamperebbe lo stesso messaggio.
 */
function _l104_assistenza_ata_segnala(FormStateInterface $form_state, $campo, array $perMese, $tetto, $unita, $norma) {
  $fuori = [];
  foreach ($perMese as $mese => $quanti) {
    if ($quanti > $tetto) {
      $fuori[] = $mese . ': ' . rtrim(rtrim(number_format($quanti, 1, ',', ''), '0'), ',') . ' ' . $unita;
    }
  }

  if ($fuori) {
    $form_state->setErrorByName($campo, t('Il limite di @tetto @unita al mese è superato (@mesi). @norma', [
      '@tetto' => $tetto,
      '@unita' => $unita,
      '@mesi' => implode('; ', $fuori),
      '@norma' => $norma,
    ]));
  }
}
