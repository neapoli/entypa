<?php

/**
 * @file
 * Installazione e disinstallazione del formulario.
 */

/**
 * Implements hook_install().
 */
function permessi_retribuiti_ata_td_install() {
  // Il formulario vive in config/update, che core non legge: lo installa
  // entypa insieme alla pagina di modulistica che lo pubblica. I
  // destinatari sono dedotti dal nome: vanno ricontrollati.
  entypa_installa_formulario('permessi_retribuiti_ata_td', 'permessi_retribuiti_ata_td');
}

/**
 * Implements hook_uninstall().
 */
function permessi_retribuiti_ata_td_uninstall() {
  // Se se ne va il formulario deve andarsene anche la pagina di modulistica
  // che lo pubblica, altrimenti nell'elenco resta una voce che non apre nulla.
  entypa_rimuovi_formulario('permessi_retribuiti_ata_td');
}
